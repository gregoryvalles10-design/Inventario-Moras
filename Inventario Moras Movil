<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="mobile-web-app-capable" content="yes">
<title>Conteo Inventario — Moras</title>
<style>
  :root{
    --bg:#14171a; --panel:#1c2024; --panel-2:#22262b; --line:#343b42;
    --ink:#ffffff; --ink-dim:#b7bfc6; --amber:#e8a33d; --amber-dim:#8a6326;
    --green:#5fb87a; --red:#e07a70;
    font-family:'IBM Plex Sans','Segoe UI',Arial,sans-serif;
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
  html,body{
    margin:0;padding:0;width:100%;height:100%;
    background:var(--bg);color:var(--ink);font-size:15px;
    overscroll-behavior:none;
  }
  #app{
    display:flex;flex-direction:column;
    min-height:100vh;min-height:100dvh;
    padding:env(safe-area-inset-top,12px) env(safe-area-inset-right,0) env(safe-area-inset-bottom,0) env(safe-area-inset-left,0);
  }

  /* ── HEADER ── */
  .header{
    background:#1a1e22;border-bottom:1px solid var(--line);
    padding:12px 16px 10px;flex-shrink:0;
  }
  .header-top{display:flex;align-items:center;justify-content:space-between;gap:8px;}
  .tag{
    display:inline-block;background:var(--amber);color:#211a0d;font-weight:700;
    font-size:10px;letter-spacing:.08em;text-transform:uppercase;
    padding:3px 8px;border-radius:4px;
  }
  .header h1{font-size:17px;margin:2px 0 0;font-weight:700;}
  .header-meta{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;}
  .metabox{display:flex;flex-direction:column;gap:4px;flex:1;min-width:140px;}
  .metabox label{font-size:10px;color:var(--ink-dim);text-transform:uppercase;letter-spacing:.06em;}
  .metabox select,.metabox input{
    background:var(--panel-2);border:1px solid var(--line);color:var(--ink);
    padding:10px 12px;border-radius:10px;font-size:15px;font-family:inherit;
    width:100%;-webkit-appearance:none;appearance:none;
  }
  .badge-count{
    background:var(--amber);color:#211a0d;font-weight:700;font-size:12px;
    padding:4px 10px;border-radius:20px;white-space:nowrap;
  }

  /* ── FORM AGREGAR ── */
  .add-panel{
    background:var(--panel);border-bottom:1px solid var(--line);
    padding:12px 16px;flex-shrink:0;
  }
  .add-panel h2{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--ink-dim);margin:0 0 10px;}
  .field{display:flex;flex-direction:column;gap:5px;position:relative;}
  .field label{font-size:11px;color:var(--ink-dim);text-transform:uppercase;letter-spacing:.05em;}
  .field input{
    background:var(--panel-2);border:1px solid var(--line);color:var(--ink);
    padding:12px 14px;border-radius:10px;font-size:16px;width:100%;font-family:inherit;
    -webkit-appearance:none;appearance:none;
  }
  .field input:focus{outline:none;border-color:var(--amber);}
  .field input[readonly]{color:var(--ink-dim);background:#191c1f;}
  .field input.bad{border-color:var(--red);}

  .row2{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px;}
  .row-full{margin-top:8px;}

  #suggest{
    position:absolute;top:100%;left:0;right:0;z-index:50;
    background:var(--panel-2);border:1px solid var(--line);border-radius:10px;
    max-height:200px;overflow-y:auto;margin-top:4px;
    box-shadow:0 8px 32px rgba(0,0,0,.6);display:none;
  }
  #suggest div{
    padding:12px 14px;cursor:pointer;font-size:14px;
    border-bottom:1px solid var(--line);color:var(--ink);
  }
  #suggest div:last-child{border-bottom:none;}
  #suggest div:active,#suggest div.active{background:var(--amber-dim);}
  #suggest .s-code{font-weight:700;color:var(--amber);margin-right:8px;}
  #suggest .s-umb{color:var(--ink-dim);font-size:11px;float:right;}

  /* ── BOTONES ── */
  .btn{
    border:none;border-radius:10px;padding:13px 18px;font-size:15px;font-weight:700;
    cursor:pointer;font-family:inherit;letter-spacing:.02em;
    transition:transform .08s ease,opacity .08s ease;
    -webkit-appearance:none;touch-action:manipulation;
  }
  .btn:active{transform:scale(0.95);opacity:.85;}
  .btn:disabled{opacity:.4;cursor:not-allowed;}
  .btn-amber{background:var(--amber);color:#211a0d;}
  .btn-ghost{background:transparent;border:1px solid var(--line);color:var(--ink);}
  .btn-green{background:var(--green);color:#0e2016;}
  .btn-red{background:transparent;color:var(--red);border:1px solid var(--red);padding:10px 14px;font-size:13px;}
  .btn-full{width:100%;text-align:center;}
  .btn-big{padding:15px 18px;font-size:16px;}

  /* ── LISTA ── */
  .list-panel{flex:1;overflow-y:auto;padding:0 0 120px;}
  .list-header{
    position:sticky;top:0;z-index:10;
    background:#1a1e22;border-bottom:1px solid var(--line);
    padding:8px 16px;
    display:grid;grid-template-columns:auto 1fr auto auto auto;gap:8px;align-items:center;
  }
  .list-header span{font-size:10px;text-transform:uppercase;letter-spacing:.05em;color:var(--ink-dim);}
  .list-header span.th-r{text-align:right;}

  .item{
    padding:12px 16px;border-bottom:1px solid var(--line);
    display:grid;grid-template-columns:auto 1fr auto;gap:8px;align-items:center;
  }
  .item.is-recount{background:rgba(232,163,61,0.07);}
  .item.is-recount .item-code{box-shadow:inset 3px 0 0 var(--amber);}
  .item-code{font-family:'IBM Plex Mono',monospace;font-size:13px;color:var(--amber);font-weight:700;padding-left:4px;}
  .item-name{font-size:13px;color:var(--ink);line-height:1.3;}
  .item-umb{font-size:11px;color:var(--ink-dim);margin-top:2px;}
  .item-nums{text-align:right;font-size:13px;line-height:1.6;}
  .item-nums b{color:var(--amber);}
  .item-actions{display:flex;flex-direction:column;gap:6px;align-items:center;}
  .recount-check{width:22px;height:22px;cursor:pointer;accent-color:var(--amber);}

  .empty-state{
    padding:48px 24px;text-align:center;
    color:var(--ink-dim);font-size:14px;line-height:1.6;
  }
  .empty-state .icon{font-size:40px;margin-bottom:12px;}

  /* ── FOOTER FIJO ── */
  .footer{
    position:fixed;bottom:0;left:0;right:0;z-index:20;
    background:#1a1e22;border-top:1px solid var(--line);
    padding:10px 16px calc(10px + env(safe-area-inset-bottom));
  }
  .footer-totals{font-size:12px;color:var(--ink-dim);margin-bottom:8px;text-align:center;}
  .footer-totals b{color:var(--ink);}
  .footer-btns{display:grid;grid-template-columns:1fr 1fr;gap:8px;}

  /* ── TOAST ── */
  .toast{
    position:fixed;bottom:100px;left:50%;transform:translateX(-50%);
    background:var(--green);color:#0e2016;padding:10px 20px;border-radius:10px;
    font-weight:700;font-size:14px;box-shadow:0 8px 24px rgba(0,0,0,.4);
    opacity:0;pointer-events:none;transition:opacity .2s,bottom .2s;z-index:100;
    white-space:nowrap;
  }
  .toast.show{opacity:1;bottom:108px;}
  .toast.error{background:var(--red);color:#fff;}
</style>
</head>
<body>
<div id="app">

  <!-- HEADER -->
  <div class="header">
    <div class="header-top">
      <div>
        <div class="tag">Producto Terminado</div>
        <h1>Conteo de Inventario</h1>
      </div>
      <div class="badge-count" id="badge">0 items</div>
    </div>
    <div class="header-meta">
      <div class="metabox">
        <label for="usuario">Usuario</label>
        <select id="usuario">
          <option value="">Selecciona...</option>
          <option>Alejandro Verdes</option><option>Antonio Corral</option>
          <option>Antonio Fernandez</option><option>Carlos Horacio</option>
          <option>Damian Duran</option><option>David Liñares</option>
          <option>Douglas Rios</option><option>Edgar Verde</option>
          <option>Emilio Patino</option><option>Francisco Gutierrez</option>
          <option>Jorge Silva</option><option>Jorge Rodriguez</option>
          <option>Jose Cortes</option><option>Marcos Bugallo</option>
          <option>Juan Naveira</option><option>Maria Loreto</option>
          <option>Martin Blanco</option><option>Oscar Lopez</option>
          <option>Oscar Sobrido</option><option>Pablo Cortizas</option>
          <option>Pablo Sanchez</option><option>Roberto Prada</option>
        </select>
      </div>
      <div class="metabox">
        <label for="fecha">Fecha</label>
        <input type="date" id="fecha">
      </div>
    </div>
  </div>

  <!-- FORM AGREGAR -->
  <div class="add-panel">
    <h2>Agregar producto</h2>
    <div class="field" style="position:relative">
      <label>Código o nombre</label>
      <input type="text" id="in-codigo" class="mono" placeholder="Ej. 700002 o EG BARRIL..." autocomplete="off" autocorrect="off" spellcheck="false">
      <div id="suggest"></div>
    </div>
    <div class="field row-full" style="margin-top:8px">
      <input type="text" id="in-nombre" readonly placeholder="Nombre del producto —">
    </div>
    <div class="row2">
      <div class="field">
        <label>Pallets</label>
        <input type="number" id="in-pallets" min="0" step="1" placeholder="0" inputmode="numeric" pattern="[0-9]*">
      </div>
      <div class="field">
        <label>Cajas / Barriles</label>
        <input type="number" id="in-cajas" min="0" step="1" placeholder="0" inputmode="numeric" pattern="[0-9]*">
      </div>
    </div>
    <div class="row-full" style="margin-top:10px">
      <button class="btn btn-amber btn-full btn-big" id="btn-add">+ Agregar al conteo</button>
    </div>
  </div>

  <!-- LISTA -->
  <div class="list-panel" id="list-panel">
    <div class="empty-state" id="empty-state">
      <div class="icon">📦</div>
      Busca un producto por código o nombre<br>y agrégalo al conteo
    </div>
    <div id="list-items"></div>
  </div>

  <!-- FOOTER -->
  <div class="footer">
    <div class="footer-totals" id="footer-totals">0 productos · 0 pallets · 0 cajas</div>
    <div class="footer-btns">
      <button class="btn btn-ghost" id="btn-clear">🗑 Vaciar</button>
      <button class="btn btn-green" id="btn-export">📤 Exportar Excel</button>
    </div>
  </div>

</div>
<div class="toast" id="toast"></div>

