LADOLID)", "umb": "CJ"}, {"codigo": "70Z144", "nombre": "EG NR 4x6 33CL PAL EG", "umb": "CJ"}, {"codigo": "70Z157", "nombre": "EG NR 1X24 33CL", "umb": "CJ"}, {"codigo": "70Z198", "nombre": "EG SLK NMP 4X6 33CL PAL EG", "umb": "CJ"}, {"codigo": "70Z210", "nombre": "EG R 24B 33CL BERLIN", "umb": "CJ"}, {"codigo": "70Z261", "nombre": "EG NR 24B 4X6PACK 25CL LN PAL EG", "umb": "CJ"}, {"codigo": "", "nombre": "", "umb": ""}];
  const byCode = {};
  MATERIALES.forEach(m => { if(m.codigo) byCode[m.codigo] = m; });

  const $ = id => document.getElementById(id);
  const fechaInput = $('fecha');
  fechaInput.value = new Date().toISOString().slice(0,10);

  let current = [];
  let selectedMat = null;
  let activeIdx = -1;

  function showToast(msg, isError=false){
    const t = $('toast');
    t.textContent = msg;
    t.className = 'toast show' + (isError ? ' error' : '');
    setTimeout(() => t.className = 'toast', 2000);
  }

  // AUTOCOMPLETE
  function renderSuggestions(query){
    const q = query.trim().toUpperCase();
    const box = $('suggest');
    if(!q){ box.style.display='none'; return; }
    const matches = MATERIALES.filter(m => m.codigo &&
      (m.codigo.toUpperCase().includes(q) || m.nombre.toUpperCase().includes(q))
    ).slice(0, 25);
    if(!matches.length){ box.style.display='none'; return; }
    box.innerHTML = matches.map((m,i) =>
      `<div data-idx="${i}" data-codigo="${m.codigo}">
        <span class="s-code">${m.codigo}</span>${m.nombre}
        <span class="s-umb">${m.umb}</span>
      </div>`
    ).join('');
    box.style.display = 'block';
    activeIdx = -1;
    Array.from(box.children).forEach(div => {
      div.addEventListener('click', () => selectMaterial(div.dataset.codigo));
      div.addEventListener('touchend', (e) => { e.preventDefault(); selectMaterial(div.dataset.codigo); });
    });
  }

  function selectMaterial(codigo){
    const m = byCode[codigo];
    if(!m) return;
    selectedMat = m;
    $('in-codigo').value = m.codigo;
    $('in-nombre').value = m.nombre;
    $('in-codigo').classList.remove('bad');
    $('suggest').style.display = 'none';
    $('in-pallets').focus();
  }

  $('in-codigo').addEventListener('input', () => {
    const val = $('in-codigo').value;
    if(!(byCode[val.trim().toUpperCase()] || byCode[val.trim()])){
      selectedMat = null;
      $('in-nombre').value = '';
    }
    renderSuggestions(val);
  });

  $('in-codigo').addEventListener('keydown', (e) => {
    const items = Array.from($('suggest').children);
    if($('suggest').style.display === 'block' && items.length){
      if(e.key==='ArrowDown'){ e.preventDefault(); activeIdx=Math.min(activeIdx+1,items.length-1); updateActive(items); }
      else if(e.key==='ArrowUp'){ e.preventDefault(); activeIdx=Math.max(activeIdx-1,0); updateActive(items); }
      else if(e.key==='Enter'){ e.preventDefault(); const pick=items[activeIdx]||items[0]; selectMaterial(pick.dataset.codigo); }
      else if(e.key==='Escape'){ $('suggest').style.display='none'; }
    } else if(e.key==='Enter'){ e.preventDefault(); tryExactMatch(); }
  });

  function updateActive(items){
    items.forEach(i => i.classList.remove('active'));
    if(items[activeIdx]){ items[activeIdx].classList.add('active'); items[activeIdx].scrollIntoView({block:'nearest'}); }
  }

  function tryExactMatch(){
    const raw = $('in-codigo').value.trim();
    if(byCode[raw]){ selectMaterial(raw); return true; }
    return false;
  }

  document.addEventListener('click', (e) => {
    if(!e.target.closest('#in-codigo') && !e.target.closest('#suggest'))
      $('suggest').style.display = 'none';
  });

  // AGREGAR
  $('btn-add').addEventListener('click', addItem);
  function addItem(){
    if(!selectedMat) tryExactMatch();
    if(!selectedMat){
      $('in-codigo').classList.add('bad');
      showToast('Código no encontrado', true);
      return;
    }
    const pallets = parseInt($('in-pallets').value) || 0;
    const cajas   = parseInt($('in-cajas').value)   || 0;
    if(pallets===0 && cajas===0){ showToast('Ingresa pallets o cajas/barriles', true); return; }
    const idx = current.findIndex(r => r.codigo === selectedMat.codigo);
    if(idx >= 0){
      current[idx].pallets += pallets;
      current[idx].cajas   += cajas;
      showToast(`✅ ${selectedMat.codigo} actualizado`);
    } else {
      current.push({ codigo:selectedMat.codigo, nombre:selectedMat.nombre, umb:selectedMat.umb, pallets, cajas, reconteo:false });
      showToast(`✅ ${selectedMat.codigo} agregado`);
    }
    $('in-codigo').value=''; $('in-nombre').value=''; $('in-pallets').value=''; $('in-cajas').value='';
    selectedMat = null;
    $('in-codigo').classList.remove('bad');
    $('in-codigo').focus();
    render();
  }

  function render(){
    const empty = $('empty-state');
    const listEl = $('list-items');
    if(current.length === 0){
      empty.style.display = '';
      listEl.innerHTML = '';
    } else {
      empty.style.display = 'none';
      listEl.innerHTML = current.map((r,i) => `
        <div class="item ${r.reconteo?'is-recount':''}">
          <div>
            <div class="item-code">${r.codigo}</div>
            <div class="item-umb">${r.umb}</div>
          </div>
          <div>
            <div class="item-name">${r.nombre}</div>
            <div class="item-nums"><b>${r.pallets}</b> pal · <b>${r.cajas}</b> caj</div>
          </div>
          <div class="item-actions">
            <input type="checkbox" class="recount-check" data-i="${i}" ${r.reconteo?'checked':''}>
            <button class="btn btn-red" data-i="${i}">✕</button>
          </div>
        </div>
      `).join('');
      listEl.querySelectorAll('.recount-check').forEach(chk => {
        chk.addEventListener('change', () => { current[+chk.dataset.i].reconteo=chk.checked; render(); });
      });
      listEl.querySelectorAll('.btn-red').forEach(b => {
        b.addEventListener('click', () => { current.splice(+b.dataset.i,1); render(); });
      });
    }
    const tp = current.reduce((s,r)=>s+r.pallets,0);
    const tc = current.reduce((s,r)=>s+r.cajas,0);
    const tr = current.filter(r=>r.reconteo).length;
    $('badge').textContent = `${current.length} item${current.length!==1?'s':''}`;
    $('footer-totals').innerHTML = `<b>${current.length}</b> productos · <b>${tp}</b> pallets · <b>${tc}</b> cajas` +
      (tr ? ` · <b>${tr}</b> reconteo` : '');
  }

  $('btn-clear').addEventListener('click', () => {
    if(current.length && !confirm('¿Vaciar el conteo?')) return;
    current = []; render();
  });

  // EXPORTAR — UN SOLO EXCEL CON 3 HOJAS
  $('btn-export').addEventListener('click', () => {
    if(!current.length){ showToast('No hay productos', true); return; }
    if(!$('usuario').value){ showToast('Selecciona un usuario', true); $('usuario').focus(); return; }
    const fecha   = fechaInput.value || new Date().toISOString().slice(0,10);
    const usuario = $('usuario').value;
    const sorted  = [...current].sort((a,b) => a.codigo.localeCompare(b.codigo));

    // Hoja 1: Conteo completo
    const ws1 = XLSX.utils.json_to_sheet(sorted.map(r => ({
      'Fecha':fecha,'Usuario':usuario,'Código':r.codigo,'Producto':r.nombre,
      'UMB':r.umb,'Pallets completos':r.pallets,'Cajas o barriles':r.cajas,
      'Reconteo':r.reconteo?'Sí':'No'
    })));
    ws1['!cols'] = [{wch:12},{wch:20},{wch:10},{wch:38},{wch:6},{wch:16},{wch:16},{wch:10}];

    // Hoja 2: Solo reconteos
    const reconteos = sorted.filter(r => r.reconteo);
    const ws2 = XLSX.utils.json_to_sheet(reconteos.length ? reconteos.map(r => ({
      'Código':r.codigo,'Producto':r.nombre,'UMB':r.umb,
      'Pallets':r.pallets,'Cajas o barriles':r.cajas
    })) : [{'Aviso':'No hay productos marcados para reconteo'}]);
    ws2['!cols'] = [{wch:10},{wch:38},{wch:6},{wch:12},{wch:16}];

    // Hoja 3: Resumen totales
    const tp = current.reduce((s,r)=>s+r.pallets,0);
    const tc = current.reduce((s,r)=>s+r.cajas,0);
    const ws3 = XLSX.utils.json_to_sheet([
      {'Resumen':'Fecha',         'Valor':fecha},
      {'Resumen':'Usuario',       'Valor':usuario},
      {'Resumen':'Total productos','Valor':current.length},
      {'Resumen':'Total pallets', 'Valor':tp},
      {'Resumen':'Total cajas',   'Valor':tc},
      {'Resumen':'Para reconteo', 'Valor':reconteos.length},
    ]);
    ws3['!cols'] = [{wch:18},{wch:30}];

    // Un solo workbook
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws1, 'Conteo Inventario');
    XLSX.utils.book_append_sheet(wb, ws2, 'Reconteos');
    XLSX.utils.book_append_sheet(wb, ws3, 'Resumen');

    const slug = usuario.replace(/\s+/g,'_');
    XLSX.writeFile(wb, `Inventario_${fecha.replace(/-/g,'')}_${slug}.xlsx`);
    showToast('✅ Excel exportado (3 hojas)');
  });

  render();
})();
</script>
